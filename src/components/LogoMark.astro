    d="M615.001 650.265V380.413c0-25.133-18.204-44.081-42.28-44.081-4.541 0-9.122.705-13.624 2.075l-129.7 39.305c-23.293 7.047-40.87 30.927-40.87 55.513v58.644c0 25.134 18.165 44.082 42.28 44.082a47 47 0 0 0 13.624-2.075l13.78-4.15v120.578c0 27.482 22.12 49.836 49.327 49.836h58.058c27.247 0 49.366-22.354 49.366-49.875z"
