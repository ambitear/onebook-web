---
import LogoMark from './LogoMark.astro'
import { copy, docsUrl, SITE } from '../lib/site'
import type { Lang } from '../lib/site'

const lang = Astro.props.lang
const t = copy[lang]
const other: Lang = lang === 'en' ? 'zh' : 'en'
const switchHref = lang === 'en' ? '/zh/' : '/'
---

<header class="masthead">
  <div class="masthead__bar">
    <a class="wordmark" href={lang === 'zh' ? '/zh/' : '/'}>
      <LogoMark size={26} />
      <span translate="no">OneBook</span>
    </a>

    <nav class="masthead__nav" id="site-nav" aria-label={t.nav.menu}>
      <a class="navlink" href={docsUrl(lang, 'overview')}>{t.nav.docs}</a>
      <a class="navlink" href={SITE.repo} rel="noopener noreferrer" target="_blank">{t.nav.github}</a>
      <a class="navlink" href={switchHref} hreflang={other}>{t.nav.switchTo}</a>
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        data-label-light={t.nav.themeLight}
        data-label-dark={t.nav.themeDark}
        aria-label={t.nav.themeDark}
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" />
          <path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
          />
        </svg>
        <span class="theme-toggle__label">{t.nav.themeDark}</span>
      </button>
    </nav>

    <button
      type="button"
      class="menu-btn"
      data-menu
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t.nav.menu}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path class="menu-btn__bars" d="M4 7h16M4 12h16M4 17h16" />
        <path class="menu-btn__x" d="M5 5l14 14M19 5L5 19" />
      </svg>
    </button>
  </div>
</header>

<script>
  const KEY = 'starlight-theme'
  const root = document.documentElement

  function current(): string {
    const explicit = root.dataset.theme
    if (explicit === 'dark' || explicit === 'light') return explicit
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
  }

  function sync() {
    const isDark = current() === 'dark'
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isDark))
      const light = btn.dataset.labelLight ?? ''
      const dark = btn.dataset.labelDark ?? ''
      const label = btn.querySelector('.theme-toggle__label')
      if (label) label.textContent = isDark ? light : dark
      btn.setAttribute('aria-label', isDark ? light : dark)
    })
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((node) => {
    const btn = node as HTMLElement
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark'
      root.dataset.theme = next
      try {
        localStorage.setItem(KEY, next)
      } catch {}
      sync()
    })
  })

  document.querySelectorAll('[data-menu]').forEach((node) => {
    const btn = node as HTMLElement
    btn.addEventListener('click', () => {
      const head = btn.closest('.masthead')
      if (!head) return
      const open = head.toggleAttribute('data-menu-open')
      btn.setAttribute('aria-expanded', String(open))
    })
  })

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync)
  sync()
</script>
